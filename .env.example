DB_NAME=brand
DB_USER=brand
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
HTTP_PORT=8080
CORS_ORIGIN=
# Random string of 32+ characters that signs admin sessions, e.g. `openssl rand -hex 32`
ADMIN_SECRET=
# Set to true when the site is served over HTTPS
COOKIE_SECURE=false
# Online payments (Razorpay Dashboard → Account & Settings → API keys). Use test keys (rzp_test_…) until you go live.
# Leave empty to offer cash on delivery only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Webhooks: URL https://<your domain>/api/payments/razorpay/webhook,
# events order.paid and payment.captured, and the secret you set there.
RAZORPAY_WEBHOOK_SECRET=
# Emails: order thank-yous, new-order alerts and the soda waitlist thank-you. Any SMTP service works (Gmail with an
# app password, Zoho, Brevo, Amazon SES…). Leave SMTP_HOST empty to send none.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nxtsip <orders@your-domain.in>"
# The site's public address, for links and the logo in emails, e.g. https://nxtsip.in
SITE_URL=
